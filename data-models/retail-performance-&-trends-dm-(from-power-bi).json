        {
          "id": "NetRevenuePYPP",
          "kind": "table",
          "source": {
            "elementId": "9P3jvPDvTk",
            "kind": "table"
          },
          "columns": [
            {
              "id": "NetRevenuePY_d",
              "formula": "DateTrunc(\"year\", [ORDER_FACT View/Full Date (DATE_DIM)])",
              "name": "Year"
            },
            {
              "id": "NetRevenuePY_v",
              "formula": "Sum([ORDER_FACT View/Net Revenue])",
              "name": "Net Revenue"
            },
            {
              "id": "NetRevenuePY_p",
              "formula": "DateLookback([Net Revenue], [Year], 1, \"year\")",
              "name": "Net Revenue (Prior Year)"
            },
            {
              "id": "NetRevenuePY_y",
              "formula": "([Net Revenue] - [Net Revenue (Prior Year)]) / [Net Revenue (Prior Year)]",
              "name": "Net Revenue YoY %",
              "format": {
                "kind": "number",
                "formatString": ",.1%"
              }
            }
          ],
          "name": "Net Revenue PY",
          "groupings": [
            {
              "id": "NetRevenuePY_g",
              "groupBy": [
                "NetRevenuePY_d"
              ],
              "calculations": [
                "NetRevenuePY_v",
                "NetRevenuePY_p",
                "NetRevenuePY_y"
              ]
            }
          ]
        },
