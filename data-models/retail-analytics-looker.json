            "statement": "SELECT\n        o.ORDER_ID,\n        o.ORDER_LINE,\n        o.ORDER_STATUS,\n        o.ORDER_CHANNEL,\n        o.SHIP_METHOD,\n        o.CUSTOMER_KEY,\n        o.PRODUCT_KEY,\n        o.ORDER_STORE_KEY,\n        o.SHIP_STORE_KEY,\n        o.PROMO_KEY,\n        o.ORDER_DATE_KEY,\n        o.SHIP_DATE_KEY,\n        o.RETURN_DATE_KEY,\n        o.UNIT_PRICE,\n        o.UNIT_COST,\n        o.QUANTITY_ORDERED,\n        o.QUANTITY_RETURNED,\n        o.GROSS_REVENUE,\n        o.NET_REVENUE,\n        o.DISCOUNT_AMOUNT,\n        o.TAX_AMOUNT,\n        o.SHIPPING_AMOUNT,\n        o.GROSS_PROFIT,\n        o.NET_PROFIT,\n        o.DAYS_TO_SHIP,\n        o.IS_RETURNED,\n        o.IS_CANCELLED,\n        o.IS_FIRST_ORDER,\n        -- Derived: gross margin pct at the row level\n        CASE\n          WHEN o.GROSS_REVENUE > 0\n          THEN ROUND(o.GROSS_PROFIT / o.GROSS_REVENUE * 100, 2)\n          ELSE NULL\n        END AS GROSS_MARGIN_PCT\n      FROM CSA.TJ.ORDER_FACT o\n      WHERE o.IS_CANCELLED = FALSE",
            "kind": "sql"
          },
