        {
          "id": "mWJme0LDUw",
          "kind": "table",
          "source": {
            "connectionId": "cb2f5180-641f-47bd-8efa-da9d590d855a",
            "statement": "SELECT\n        p.PRODUCT_KEY,\n        p.PRODUCT_ID,\n        p.PRODUCT_NAME,\n        p.CATEGORY,\n        p.SUBCATEGORY,\n        p.BRAND,\n        p.LAUNCH_DATE,\n        p.DISCONTINUE_DATE,\n        p.UNIT_COST,\n        p.UNIT_PRICE,\n        p.WEIGHT_LBS,\n        p.IS_ACTIVE,\n        p.IS_PRIVATE_LABEL,\n        p.IS_SEASONAL,\n        -- Derived: list margin pct\n        CASE\n          WHEN p.UNIT_PRICE > 0\n          THEN ROUND((p.UNIT_PRICE - p.UNIT_COST) / p.UNIT_PRICE * 100, 2)\n          ELSE NULL\n        END AS LIST_MARGIN_PCT,\n        -- Derived: margin band bucket\n        CASE\n          WHEN p.UNIT_PRICE <= 0 THEN 'Unknown'\n          WHEN (p.UNIT_PRICE - p.UNIT_COST) / p.UNIT_PRICE >= 0.5 THEN 'High (50%+)'\n          WHEN (p.UNIT_PRICE - p.UNIT_COST) / p.UNIT_PRICE >= 0.3 THEN 'Mid (30-50%)'\n          WHEN (p.UNIT_PRICE - p.UNIT_COST) / p.UNIT_PRICE >= 0.1 THEN 'Low (10-30%)'\n          ELSE 'Negative'\n        END AS MARGIN_BAND\n      FROM CSA.TJ.PRODUCT_DIM p\n      WHERE p.IS_ACTIVE = TRUE\n        AND p.DISCONTINUE_DATE IS NULL",
            "kind": "sql"
          },
