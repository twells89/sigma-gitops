            {
              "id": "iLR-3m7c7A",
              "formula": "If([Order Channel] = \"Online\", \"Digital\", If([Order Channel] = \"Mobile\", \"Digital\", \"Physical\"))",
              "name": "Revenue Tier"
            },
            {
              "id": "7-I7ce5hJH",
              "formula": "If([Gross Revenue] > 1000, \"Large\", If([Gross Revenue] > 250, \"Medium\", \"Small\"))",
              "name": "Order Size Band"
            },
            {
              "id": "HDa8ZfZCLT",
              "formula": "DateDiff(\"day\", [ORDER_FACT/PROMO KEY Link], [ORDER_FACT/PROMO KEY Link])",
              "name": "Promo Duration Days"
            },
            {
              "id": "3r-vl1zx8S",
              "formula": "Round([Gross Profit] / [Gross Revenue] * 100, 2)",
              "name": "Gross Margin Pct (Row)"
            },
            {
              "id": "fwhCmsKmKL",
              "formula": "Coalesce([Net Revenue], 0)",
              "name": "Safe Net Revenue"
            },
            {
              "id": "VTWJQHxH07",
              "formula": "Year([ORDER_FACT/ORDER DATE KEY Link])",
              "name": "Order Year"
