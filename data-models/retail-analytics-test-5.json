            "statement": "SELECT\n        d.DATE_KEY,\n        d.FULL_DATE,\n        d.DAY_OF_WEEK,\n        d.DAY_OF_MONTH,\n        d.WEEK_OF_YEAR,\n        d.MONTH_NUMBER,\n        d.MONTH_NAME,\n        d.QUARTER,\n        d.YEAR,\n        d.FISCAL_PERIOD,\n        d.IS_WEEKEND,\n        d.IS_HOLIDAY,\n        -- Derived: retail season bucket\n        CASE\n          WHEN d.MONTH_NUMBER IN (11, 12)  THEN 'Holiday'\n          WHEN d.MONTH_NUMBER IN (3, 4, 5) THEN 'Spring'\n          WHEN d.MONTH_NUMBER IN (6, 7, 8) THEN 'Summer'\n          ELSE 'Fall'\n        END AS RETAIL_SEASON,\n        -- Derived: business day flag\n        CASE\n          WHEN d.IS_WEEKEND = TRUE OR d.IS_HOLIDAY = TRUE THEN FALSE\n          ELSE TRUE\n        END AS IS_BUSINESS_DAY\n      FROM CSA.TJ.DATE_DIM d",
