        {
          "id": "3hRCqN46HS",
          "kind": "table",
          "source": {
            "connectionId": "cb2f5180-641f-47bd-8efa-da9d590d855a",
            "statement": "SELECT\n        p.PROMO_KEY,\n        p.PROMO_ID,\n        p.PROMO_NAME,\n        p.PROMO_TYPE,\n        p.CHANNEL,\n        p.TARGET_SEGMENT,\n        p.IS_STACKABLE,\n        p.START_DATE,\n        p.END_DATE,\n        p.DISCOUNT_PCT,\n        p.PROMO_COST,\n        p.MIN_ORDER_AMOUNT,\n        -- Derived: promo duration in days\n        DATEDIFF('day', p.START_DATE, p.END_DATE) AS PROMO_DURATION_DAYS,\n        -- Derived: daily cost\n        CASE\n          WHEN DATEDIFF('day', p.START_DATE, p.END_DATE) > 0\n          THEN ROUND(p.PROMO_COST / DATEDIFF('day', p.START_DATE, p.END_DATE), 2)\n          ELSE p.PROMO_COST\n        END AS DAILY_PROMO_COST,\n        -- Derived: discount depth bucket\n        CASE\n          WHEN p.DISCOUNT_PCT >= 0.4  THEN 'Deep (40%+)'\n          WHEN p.DISCOUNT_PCT >= 0.2  THEN 'Mid (20-40%)'\n          WHEN p.DISCOUNT_PCT >= 0.05 THEN 'Shallow (5-20%)'\n          ELSE 'Nominal (<5%)'\n        END AS DISCOUNT_DEPTH\n      FROM CSA.TJ.PROMO_DIM p\n      WHERE p.END_DATE >= DATEADD('year', -2, CURRENT_DATE())",
            "kind": "sql"
          },
