            },
            {
              "id": "QsqNhb2YFY",
              "formula": "If([Gross Revenue] > 1000, \"Large\", If([Gross Revenue] > 250, \"Medium\", \"Small\"))",
              "name": "Order Size Band"
            },
            {
              "id": "Iwr8duYqC6",
              "formula": "DateDiff(\"day\", [ORDER_FACT/PROMO KEY Link], [ORDER_FACT/PROMO KEY Link])",
