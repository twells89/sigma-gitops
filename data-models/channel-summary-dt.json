          "source": {
            "connectionId": "cb2f5180-641f-47bd-8efa-da9d590d855a",
            "statement": "SELECT\n  o.ORDER_CHANNEL,\n  d.YEAR,\n  d.MONTH_NUMBER,\n  COUNT(DISTINCT o.ORDER_ID)          AS order_count,\n  COUNT(DISTINCT o.CUSTOMER_KEY)      AS customer_count,\n  SUM(o.GROSS_REVENUE)                AS gross_revenue,\n  SUM(o.NET_REVENUE)                  AS net_revenue,\n  SUM(o.GROSS_PROFIT)                 AS gross_profit,\n  SUM(o.DISCOUNT_AMOUNT)              AS discount_amount,\n  SUM(o.QUANTITY_ORDERED)             AS units_ordered,\n  ROUND(SUM(o.GROSS_PROFIT) / NULLIF(SUM(o.GROSS_REVENUE), 0) * 100, 2) AS gross_margin_pct\nFROM CSA.TJ.ORDER_FACT o\nLEFT JOIN CSA.TJ.DATE_DIM d ON o.ORDER_DATE_KEY = d.DATE_KEY\nWHERE o.ORDER_STATUS NOT IN ('Cancelled', 'Returned')\nGROUP BY 1, 2, 3",
            "kind": "sql"
          },
