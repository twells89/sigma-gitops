        {
          "id": "eOq9xTgf4O",
          "kind": "table",
          "source": {
            "connectionId": "cb2f5180-641f-47bd-8efa-da9d590d855a",
            "statement": "SELECT\n  f.TRANSACTIONID AS TransactionID,\n  f.DATE AS Date,\n  f.DATE_MONTHLABEL AS Date_monthLabel,\n  f.DATE_QUARTERLABEL AS Date_quarterLabel,\n  f.DATE_YEARMONTH AS MonthYear,\n  f.DATE_YEAR AS Date_year,\n  f.STOREID AS StoreID,\n  f.PRODUCTID AS ProductID,\n  f.EMPLOYEEID AS EmployeeID,\n  f.QUANTITY AS Quantity,\n  f.UNITPRICE AS UnitPrice,\n  f.DISCOUNTPCT AS DiscountPct,\n  f.TOTALAMOUNT AS TotalAmount,\n  f.PAYMENTMETHOD AS PaymentMethod,\n  a.PRODUCTNAME AS ProductName,\n  a.CATEGORY AS Category,\n  a.SUBCATEGORY AS SubCategory,\n  a.BRAND AS Brand,\n  a.UNITCOST AS UnitCost,\n  a.RETAILPRICE AS RetailPrice,\n  a.MARGINPCT AS MarginPct,\n  a.SUPPLIER AS Supplier,\n  b.STORENAME AS StoreName,\n  b.CITY AS City,\n  b.STATE AS State,\n  b.REGION AS Region,\n  b.STORETYPE AS StoreType,\n  b.SQUAREFOOTAGE AS SquareFootage,\n  b.STOREMANAGER AS StoreManager\nFROM CSA.QLIK_SPARK_ELECTRONICS.SALES f\nLEFT JOIN CSA.QLIK_SPARK_ELECTRONICS.PRODUCTS a ON f.PRODUCTID = a.PRODUCTID\nLEFT JOIN CSA.QLIK_SPARK_ELECTRONICS.STORES b ON f.STOREID = b.STOREID",
            "kind": "sql"
