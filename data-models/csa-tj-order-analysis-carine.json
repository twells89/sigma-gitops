          "name": "Orders",
          "metrics": [
            {
              "id": "zL9GL-CY0s",
              "formula": "Sum([NET_REVENUE])",
              "name": "Total Revenue",
              "description": "Sum of net revenue from all orders"
            },
            {
              "id": "ejm8s-mrR9",
              "formula": "CountDistinct([ORDER_ID])",
              "name": "Total Orders",
              "description": "Count of unique orders"
            },
            {
              "id": "2g0VhB0WKx",
              "formula": "Sum([NET_REVENUE]) / CountDistinct([ORDER_ID])",
              "name": "Average Order Value",
              "description": "Average revenue per order"
            },
            {
              "id": "w7ZCyFU3ok",
              "formula": "Sum([NET_PROFIT])",
              "name": "Total Profit",
              "description": "Sum of net profit from all orders"
            },
            {
              "id": "8nBSM9Hb8q",
              "formula": "Sum([NET_PROFIT]) / Sum([NET_REVENUE])",
              "name": "Profit Margin",
              "description": "Net profit as percentage of net revenue"
            },
            {
              "id": "ynXdWFZj_W",
              "formula": "Sum([QUANTITY_ORDERED])",
              "name": "Units Sold",
              "description": "Total quantity of items ordered"
            },
            {
              "id": "0L7HjP9xRN",
              "formula": "Sum([IS_CANCELLED]) / CountDistinct([ORDER_ID])",
              "name": "Cancellation Rate",
              "description": "Percentage of orders that were cancelled"
            },
            {
              "id": "12WGRBxmJK",
              "formula": "Sum([NET_REVENUE])",
              "name": "Total Revenue",
              "description": "Sum of net revenue from all orders"
            },
            {
              "id": "slQo53_gk7",
              "formula": "Sum([QUANTITY_ORDERED]) / CountDistinct([ORDER_ID])",
              "name": "Average Quantity per Order",
              "description": "Average quantity of items per unique order"
            },
            {
              "id": "ltRTM0CF6l",
              "formula": "CountDistinct([CUSTOMER_KEY])",
              "name": "Unique Customers",
              "description": "Count of distinct customers who placed orders"
            },
            {
              "id": "U7XTtcUYqi",
              "formula": "Sum([IS_RETURNED]) / Sum([QUANTITY_ORDERED])",
              "name": "Return Rate",
              "description": "Percentage of ordered items that were returned"
            },
            {
              "id": "MDQc7834gR",
              "formula": "Avg([DAYS_TO_SHIP])",
              "name": "Average Days to Ship",
              "description": "Average number of days from order to shipment"
            },
            {
              "id": "FeP78JaoCI",
              "formula": "SumIf([IS_FIRST_ORDER], [NET_REVENUE]) / Sum([NET_REVENUE])",
              "name": "First Order Revenue %",
              "description": "Percentage of total revenue from first-time customer orders"
            },
            {
              "id": "p_3SdgXT5O",
              "formula": "Sum([NET_REVENUE]) / CountDistinct([CUSTOMER_KEY])",
              "name": "Revenue per Customer",
              "description": "Average revenue generated per unique customer"
            },
            {
              "id": "ojQ8tF9_9r",
              "formula": "Sum([DISCOUNT_AMOUNT]) / Sum([GROSS_REVENUE])",
              "name": "Discount Rate",
              "description": "Percentage of gross revenue given as discounts"
            }
