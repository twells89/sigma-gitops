              "name": "Quarter"
            },
            {
              "id": "c-fs-8",
              "formula": "[Custom SQL/Amount ($K)]",
              "name": "Amount ($K)"
            }
          ],
          "name": "Financial Statements",
          "metrics": [
            {
              "id": "m-rev",
              "formula": "Sum(If([Statement Type] = \"Income Statement\" and [Category] = \"Revenues\", [Amount ($K)], 0))",
              "name": "Revenue ($K)"
            },
            {
              "id": "m-cost",
              "formula": "Sum(If([Statement Type] = \"Income Statement\" and In([Category], \"Cost of Revenues\", \"Operating Expenses\"), [Amount ($K)], 0))",
              "name": "Cost ($K)"
            },
            {
              "id": "m-oi",
              "formula": "Sum(If([Statement Type] = \"Income Statement\" and In([Category], \"Revenues\", \"Cost of Revenues\", \"Operating Expenses\"), [Amount ($K)], 0))",
              "name": "Operating Income ($K)"
            },
            {
              "id": "m-oipct",
              "formula": "(Sum(If([Statement Type] = \"Income Statement\" and In([Category], \"Revenues\", \"Cost of Revenues\", \"Operating Expenses\"), [Amount ($K)], 0))) / (Sum(If([Statement Type] = \"Income Statement\" and [Category] = \"Revenues\", [Amount ($K)], 0)))",
              "name": "Operating Income %"
            }
          ],
          "order": [
