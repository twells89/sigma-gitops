          "id": "el-fs",
          "kind": "table",
          "source": {
            "connectionId": "cb2f5180-641f-47bd-8efa-da9d590d855a",
            "statement": "SELECT STATEMENT_TYPE AS \"Statement Type\", GROUP_NAME AS \"Group\", CATEGORY AS \"Category\", ACTIVITY AS \"Activity\", TYPE_NAME AS \"Type\", DESCRIPTION AS \"Description\", YEAR AS \"Year\", QUARTER AS \"Quarter\", AMOUNT_K AS \"Amount ($K)\" FROM CSA.TJ.EXEC_FIN_FINANCIAL_STATEMENTS",
            "kind": "sql"
          },
          "columns": [
            {
              "id": "c-fs-0",
              "formula": "[Custom SQL/Statement Type]",
              "name": "Statement Type"
            },
            {
