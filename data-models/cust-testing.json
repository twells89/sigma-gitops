          "kind": "table",
          "source": {
            "connectionId": "cb2f5180-641f-47bd-8efa-da9d590d855a",
            "statement": "SELECT\n    f.ORDER_ID,\n    f.ORDER_LINE,\n    f.ORDER_CHANNEL,\n    f.ORDER_STATUS,\n    f.SHIP_METHOD,\n    f.GROSS_REVENUE,\n    f.NET_REVENUE,\n    f.DISCOUNT_AMOUNT,\n    f.QUANTITY_ORDERED,\n    f.IS_RETURNED,\n    f.IS_CANCELLED,\n    od.FULL_DATE     AS ORDER_DATE,\n    sd.FULL_DATE     AS SHIP_DATE,\n    c.CUSTOMER_ID,\n    c.FIRST_NAME,\n    c.LAST_NAME,\n    c.CUSTOMER_SEGMENT,\n    c.LOYALTY_TIER,\n    c.REGION         AS CUSTOMER_REGION,\n    p.PRODUCT_ID,\n    p.PRODUCT_NAME,\n    p.CATEGORY,\n    p.SUBCATEGORY,\n    p.BRAND,\n    os.STORE_NAME    AS ORDER_STORE_NAME,\n    os.REGION        AS ORDER_STORE_REGION,\n    pr.PROMO_NAME,\n    pr.PROMO_TYPE,\n    pr.DISCOUNT_PCT  AS PROMO_DISCOUNT_PCT\n\nFROM CSA.TJ.ORDER_FACT f\n\n    INNER JOIN CSA.TJ.DATE_DIM     od ON f.ORDER_DATE_KEY  = od.DATE_KEY\n    LEFT  JOIN CSA.TJ.DATE_DIM     sd ON f.SHIP_DATE_KEY   = sd.DATE_KEY\n    LEFT  JOIN CSA.TJ.CUSTOMER_DIM  c ON f.CUSTOMER_KEY    = c.CUSTOMER_KEY\n    LEFT  JOIN CSA.TJ.PRODUCT_DIM   p ON f.PRODUCT_KEY     = p.PRODUCT_KEY\n    LEFT  JOIN CSA.TJ.STORE_DIM    os ON f.ORDER_STORE_KEY = os.STORE_KEY\n    LEFT  JOIN CSA.TJ.PROMO_DIM    pr ON f.PROMO_KEY       = pr.PROMO_KEY\n\nWHERE\n    (\n        'admin' IN ({{system::CurrentUserAttributeText::customer_segment}})\n        OR\n        c.CUSTOMER_SEGMENT IN ({{system::CurrentUserAttributeText::customer_segment}})\n    )\nAND od.FULL_DATE BETWEEN\n    TO_DATE(TO_TIMESTAMP({{p-Order-Date-Range}}:start))\n    AND TO_DATE(TO_TIMESTAMP({{p-Order-Date-Range}}:end))",
            "kind": "sql"
          },
