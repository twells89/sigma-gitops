          "source": {
            "connectionId": "cb2f5180-641f-47bd-8efa-da9d590d855a",
            "statement": "SELECT\n    d.CUSTOMER_KEY,\n    f.ORDER_ID,\n    f.ORDER_LINE,\n    f.ORDER_CHANNEL,\n    f.ORDER_STATUS,\n    f.SHIP_METHOD,\n    f.UNIT_PRICE,\n    f.UNIT_COST,\n    f.QUANTITY_ORDERED,\n    f.QUANTITY_RETURNED,\n    f.GROSS_REVENUE,\n    f.NET_REVENUE,\n    f.DISCOUNT_AMOUNT,\n    f.TAX_AMOUNT,\n    f.SHIPPING_AMOUNT,\n    f.GROSS_PROFIT,\n    f.NET_PROFIT,\n    f.DAYS_TO_SHIP,\n    f.IS_FIRST_ORDER,\n    f.IS_RETURNED,\n    f.IS_CANCELLED,\n    f.ORDER_STORE_KEY,\n    f.SHIP_STORE_KEY,\n    od.FULL_DATE     AS ORDER_DATE,\n    od.YEAR          AS ORDER_YEAR,\n    od.QUARTER       AS ORDER_QUARTER,\n    od.MONTH_NUMBER  AS ORDER_MONTH_NUM,\n    od.MONTH_NAME    AS ORDER_MONTH_NAME,\n    od.DAY_OF_WEEK   AS ORDER_DOW,\n    od.IS_WEEKEND    AS ORDER_IS_WEEKEND,\n    od.IS_HOLIDAY    AS ORDER_IS_HOLIDAY,\n    od.FISCAL_PERIOD AS ORDER_FISCAL_PERIOD,\n    sd.FULL_DATE     AS SHIP_DATE,\n    rd.FULL_DATE     AS RETURN_DATE,\n    c.CUSTOMER_ID,\n    c.FIRST_NAME,\n    c.LAST_NAME,\n    c.EMAIL,\n    c.CITY           AS CUSTOMER_CITY,\n    c.STATE          AS CUSTOMER_STATE,\n    c.REGION         AS CUSTOMER_REGION,\n    c.CUSTOMER_SEGMENT,\n    c.LOYALTY_TIER,\n    c.ACQUISITION_CHANNEL,\n    p.PRODUCT_ID,\n    p.PRODUCT_NAME,\n    p.CATEGORY,\n    p.SUBCATEGORY,\n    p.BRAND,\n    os.STORE_NAME    AS ORDER_STORE_NAME,\n    os.STORE_TYPE    AS ORDER_STORE_TYPE,\n    os.CITY          AS ORDER_STORE_CITY,\n    os.STATE         AS ORDER_STORE_STATE,\n    os.REGION        AS ORDER_STORE_REGION,\n    ss.STORE_NAME    AS SHIP_STORE_NAME,\n    ss.REGION        AS SHIP_STORE_REGION,\n    pr.PROMO_ID,\n    pr.PROMO_NAME,\n    pr.PROMO_TYPE,\n    pr.DISCOUNT_PCT  AS PROMO_DISCOUNT_PCT\n\nFROM CSA.TJ.ORDER_FACT f\n\n    INNER JOIN CSA.TJ.DATE_DIM      od ON f.ORDER_DATE_KEY  = od.DATE_KEY\n    LEFT  JOIN CSA.TJ.DATE_DIM      sd ON f.SHIP_DATE_KEY   = sd.DATE_KEY\n    LEFT  JOIN CSA.TJ.DATE_DIM      rd ON f.RETURN_DATE_KEY = rd.DATE_KEY\n    LEFT  JOIN CSA.TJ.CUSTOMER_DIM   c ON f.CUSTOMER_KEY    = c.CUSTOMER_KEY\n    LEFT  JOIN CSA.TJ.PRODUCT_DIM    p ON f.PRODUCT_KEY     = p.PRODUCT_KEY\n    LEFT  JOIN CSA.TJ.STORE_DIM     os ON f.ORDER_STORE_KEY = os.STORE_KEY\n    LEFT  JOIN CSA.TJ.STORE_DIM     ss ON f.SHIP_STORE_KEY  = ss.STORE_KEY\n    LEFT  JOIN CSA.TJ.PROMO_DIM     pr ON f.PROMO_KEY       = pr.PROMO_KEY\n    INNER JOIN CSA.TJ.CUSTOMER_DIM   d ON f.CUSTOMER_KEY    = d.CUSTOMER_KEY\n\nWHERE\n    (\n        'admin' IN ({{system::CurrentUserAttributeText::customer_segment}})\n        OR\n        c.CUSTOMER_SEGMENT IN ({{system::CurrentUserAttributeText::customer_segment}})\n    )\nAND od.FULL_DATE BETWEEN\n    TO_DATE(TO_TIMESTAMP({{p-Order-Date-Range}}:start))\n    AND TO_DATE(TO_TIMESTAMP({{p-Order-Date-Range}}:end))",
            "kind": "sql"
          },
