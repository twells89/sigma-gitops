            },
            {
              "id": "oE2rn4H664",
              "formula": "CountDistinct([ORDER_ID])",
              "name": "Total Orders",
              "description": "Count of unique orders"
            },
            {
              "id": "AfU51eARQy",
              "formula": "Sum([NET_REVENUE]) / CountDistinct([ORDER_ID])",
