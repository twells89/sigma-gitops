            },
            {
              "id": "42BoWeb8BC",
              "formula": "Sum([NET_PROFIT])",
              "name": "Total Profit",
              "description": "Sum of net profit from all orders"
            },
            {
              "id": "4CLZkIibM7",
              "formula": "Sum([NET_PROFIT]) / Sum([NET_REVENUE])",
              "name": "Profit Margin",
              "description": "Net profit as a percentage of net revenue"
            },
            {
              "id": "LF5hN0eFGn",
              "formula": "Sum([IS_RETURNED]) / Count([ORDER_ID])",
              "name": "Return Rate",
