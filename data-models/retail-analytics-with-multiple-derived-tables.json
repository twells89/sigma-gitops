        {
          "id": "x47zV_vZZ2",
          "kind": "table",
          "source": {
            "connectionId": "cb2f5180-641f-47bd-8efa-da9d590d855a",
            "statement": "SELECT\n        c.CUSTOMER_KEY,\n        c.CUSTOMER_ID,\n        c.FIRST_NAME,\n        c.LAST_NAME,\n        c.EMAIL,\n        c.PHONE,\n        c.CITY,\n        c.STATE,\n        c.REGION,\n        c.ZIP_CODE,\n        c.CUSTOMER_SEGMENT,\n        c.LOYALTY_TIER,\n        c.ACQUISITION_CHANNEL,\n        c.FIRST_ORDER_DATE,\n        c.LIFETIME_ORDER_COUNT,\n        c.LIFETIME_REVENUE,\n        c.IS_ACTIVE,\n        c.IS_EMAIL_OPT_IN,\n        -- Derived: average order value\n        CASE\n          WHEN c.LIFETIME_ORDER_COUNT > 0\n          THEN ROUND(c.LIFETIME_REVENUE / c.LIFETIME_ORDER_COUNT, 2)\n          ELSE 0\n        END AS AVG_ORDER_VALUE,\n        -- Derived: computed RFM tier\n        CASE\n          WHEN c.LIFETIME_ORDER_COUNT >= 10 AND c.LIFETIME_REVENUE >= 1000 THEN 'Champion'\n          WHEN c.LIFETIME_ORDER_COUNT >= 5  AND c.LIFETIME_REVENUE >= 500  THEN 'Loyal'\n          WHEN c.LIFETIME_ORDER_COUNT >= 2                                  THEN 'Returning'\n          ELSE 'One-Time'\n        END AS RFM_TIER\n      FROM CSA.TJ.CUSTOMER_DIM c\n      WHERE c.IS_ACTIVE = TRUE",
            "kind": "sql"
          },
