          "kind": "table",
          "source": {
            "connectionId": "cb2f5180-641f-47bd-8efa-da9d590d855a",
            "statement": "SELECT\n        s.STORE_KEY,\n        s.STORE_ID,\n        s.STORE_NAME,\n        s.STORE_TYPE,\n        s.CITY,\n        s.STATE,\n        s.REGION,\n        s.DISTRICT,\n        s.OPEN_DATE,\n        s.CLOSE_DATE,\n        s.MANAGER_NAME,\n        s.STORE_PHONE,\n        s.SQUARE_FOOTAGE,\n        s.ANNUAL_LEASE_COST,\n        s.IS_ACTIVE,\n        s.HAS_CAFE,\n        s.HAS_CURBSIDE,\n        -- Derived: store age in full years\n        DATEDIFF('year', s.OPEN_DATE, COALESCE(s.CLOSE_DATE, CURRENT_DATE())) AS STORE_AGE_YEARS,\n        -- Derived: cost per sq ft\n        CASE\n          WHEN s.SQUARE_FOOTAGE > 0\n          THEN ROUND(s.ANNUAL_LEASE_COST / s.SQUARE_FOOTAGE, 2)\n          ELSE NULL\n        END AS LEASE_COST_PER_SQFT,\n        -- Derived: size tier\n        CASE\n          WHEN s.SQUARE_FOOTAGE >= 20000 THEN 'Large (20k+ sqft)'\n          WHEN s.SQUARE_FOOTAGE >= 10000 THEN 'Medium (10-20k sqft)'\n          WHEN s.SQUARE_FOOTAGE >= 5000  THEN 'Small (5-10k sqft)'\n          ELSE 'Micro (<5k sqft)'\n        END AS SIZE_TIER\n      FROM CSA.TJ.STORE_DIM s",
            "kind": "sql"
          },
