        {
          "id": "factSales",
          "kind": "table",
          "source": {
            "connectionId": "cb2f5180-641f-47bd-8efa-da9d590d855a",
            "kind": "warehouse-table",
            "path": [
              "CSA",
              "TJ",
              "RETAIL_SALES"
            ]
          },
          "columns": [
            {
              "id": "inode-6CrHVi5U1aHwYlXBrysRiv/SCENARIO_ID",
              "formula": "[RETAIL_SALES/Scenario Id]",
              "name": "Scenario Id",
              "description": "Degenerate dimension: 1 = Actual, 2 = Plan. No scenario table exists in CSA.TJ.",
              "format": {
                "kind": "number",
                "formatString": ",.0f"
              }
            },
            {
              "id": "inode-6CrHVi5U1aHwYlXBrysRiv/REPORTING_PERIOD_ID",
              "formula": "[RETAIL_SALES/Reporting Period Id]",
              "name": "Reporting Period Id",
              "description": "YYYYMMDD grain key. Joins to Time Dimension.",
              "format": {
                "kind": "number",
                "formatString": ",.0f"
              }
            },
            {
              "id": "inode-6CrHVi5U1aHwYlXBrysRiv/MONTH_ID",
              "formula": "[RETAIL_SALES/Month Id]",
              "name": "Month Id",
              "description": "YYYYMM. Redundant with Reporting Period Id (strict 1:1 across all 8 periods) - kept for reference.",
              "format": {
                "kind": "number",
                "formatString": ",.0f"
              }
            },
            {
              "id": "inode-6CrHVi5U1aHwYlXBrysRiv/ITEM_ID",
              "formula": "[RETAIL_SALES/Item Id]",
              "name": "Item Id",
              "description": "Joins to Item Dimension.",
              "format": {
                "kind": "number",
                "formatString": ",.0f"
              }
            },
            {
              "id": "inode-6CrHVi5U1aHwYlXBrysRiv/LOCATION_ID",
              "formula": "[RETAIL_SALES/Location Id]",
              "name": "Location Id",
              "description": "Joins to Store Dimension.",
              "format": {
                "kind": "number",
                "formatString": ",.0f"
              }
            },
            {
              "id": "inode-6CrHVi5U1aHwYlXBrysRiv/SUM_REGULAR_SALES_DOLLARS",
              "formula": "[RETAIL_SALES/Sum Regular Sales Dollars]",
              "name": "Regular Sales Dollars",
              "format": {
                "kind": "number",
                "formatString": "$,.2f"
              }
            },
            {
              "id": "inode-6CrHVi5U1aHwYlXBrysRiv/SUM_MARKDOWN_SALES_DOLLARS",
              "formula": "[RETAIL_SALES/Sum Markdown Sales Dollars]",
              "name": "Markdown Sales Dollars",
              "format": {
                "kind": "number",
                "formatString": "$,.2f"
              }
            },
            {
              "id": "inode-6CrHVi5U1aHwYlXBrysRiv/SUM_REGULAR_SALES_UNITS",
              "formula": "[RETAIL_SALES/Sum Regular Sales Units]",
              "name": "Regular Sales Units",
              "format": {
                "kind": "number",
                "formatString": ",.0f"
              }
            },
            {
              "id": "inode-6CrHVi5U1aHwYlXBrysRiv/SUM_MARKDOWN_SALES_UNITS",
              "formula": "[RETAIL_SALES/Sum Markdown Sales Units]",
              "name": "Markdown Sales Units",
              "format": {
                "kind": "number",
                "formatString": ",.0f"
              }
            },
            {
              "id": "inode-6CrHVi5U1aHwYlXBrysRiv/SUM_GROSS_MARGIN_AMOUNT",
              "formula": "[RETAIL_SALES/Sum Gross Margin Amount]",
              "name": "Gross Margin Amount",
              "format": {
                "kind": "number",
                "formatString": "$,.2f"
              }
            },
            {
              "id": "colTotSalAmt",
              "formula": "[Regular Sales Dollars] + [Markdown Sales Dollars]",
              "name": "Total Sales Amount",
              "description": "Regular + markdown sales dollars.",
              "format": {
                "kind": "number",
                "formatString": "$,.2f"
              }
            },
            {
              "id": "colTotSalUnt",
              "formula": "[Regular Sales Units] + [Markdown Sales Units]",
              "name": "Total Sales Units",
              "description": "Regular + markdown units.",
              "format": {
                "kind": "number",
                "formatString": ",.0f"
              }
            },
            {
              "id": "colScenLabel",
              "formula": "If([Scenario Id] = 1, \"Actual\", [Scenario Id] = 2, \"Plan\", \"Unknown\")",
              "name": "Scenario",
              "description": "Readable label for the Scenario Id degenerate dimension."
            }
          ],
          "name": "Retail Sales Fact",
          "description": "Monthly item x store sales fact, actual and plan scenarios.",
          "metrics": [
            {
              "id": "mTotalSales",
              "formula": "Sum([Total Sales Amount])",
              "name": "Sum of Total Sales",
              "description": "All-scenario sales dollars. Filter by Scenario for actual-only.",
              "format": {
                "kind": "number",
                "formatString": "$,.0f"
              }
            },
            {
              "id": "mRegSales",
              "formula": "Sum([Regular Sales Dollars])",
              "name": "Sum of Regular Sales",
              "format": {
                "kind": "number",
                "formatString": "$,.0f"
              }
            },
            {
              "id": "mMkdSales",
              "formula": "Sum([Markdown Sales Dollars])",
              "name": "Sum of Markdown Sales",
              "format": {
                "kind": "number",
                "formatString": "$,.0f"
              }
            },
            {
              "id": "mUnits",
              "formula": "Sum([Total Sales Units])",
              "name": "Sum of Units Sold",
              "format": {
                "kind": "number",
                "formatString": ",.0f"
              }
            },
            {
              "id": "mGrossMgn",
              "formula": "Sum([Gross Margin Amount])",
              "name": "Sum of Gross Margin",
              "format": {
                "kind": "number",
                "formatString": "$,.0f"
              }
            },
            {
              "id": "mGmRate",
              "formula": "Sum([Gross Margin Amount]) / Sum([Total Sales Amount])",
              "name": "Gross Margin Rate",
              "description": "Gross margin as a percent of total sales dollars.",
              "format": {
                "kind": "number",
                "formatString": ",.1%"
              }
            },
            {
              "id": "mMkdRate",
