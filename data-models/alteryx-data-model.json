            {
              "id": "yoB0WAOGc4",
              "formula": "[ORDER_FACT/Unit Cost]",
              "description": "Per-unit cost of goods sold (COGS) for this line item."
            },
            {
              "id": "8QtEM4Q980",
              "formula": "[ORDER_FACT/Discount Amount]",
              "description": "Total discount amount applied to this order line."
            },
            {
              "id": "Slifp4qFK_",
              "formula": "[ORDER_FACT/Shipping Amount]",
              "description": "Shipping and handling charges associated with this order line."
            },
            {
              "id": "HL7qYiEFTs",
              "formula": "[ORDER_FACT/Tax Amount]",
              "description": "Sales tax amount collected for this order line."
            },
            {
              "id": "A7rJVXSU8f",
              "formula": "[ORDER_FACT/Gross Revenue]",
              "description": "Total revenue before discounts, returns, or adjustments (Quantity \u00d7 Unit Price)."
            },
            {
              "id": "iCHNdNQ4se",
              "formula": "[ORDER_FACT/Net Revenue]",
              "description": "Revenue after discounts and returns have been applied; the recognized top-line revenue."
            },
            {
              "id": "gz4fdq3AV3",
              "formula": "[ORDER_FACT/Gross Profit]",
              "description": "Gross revenue minus cost of goods sold, before operating expenses."
            },
            {
              "id": "oSE2TwCBgN",
              "formula": "[ORDER_FACT/Net Profit]",
              "description": "Net revenue minus cost of goods sold; the bottom-line profit on this order line."
            },
            {
              "id": "vJhV-0u3YV",
              "formula": "Round([Gross Profit] / If([Gross Revenue] = 0, Null, [Gross Revenue]) * 100, 2)",
              "name": "Gross Margin Pct",
              "description": "Gross profit expressed as a percentage of gross revenue, rounded to 2 decimal places."
            },
            {
              "id": "mRXsh0pv3r",
              "formula": "If([Order Channel] = \"Online\" or [Order Channel] = \"Mobile\", \"Digital\", \"Physical\")",
              "name": "Channel Group",
              "description": "Classifies the order channel into 'Digital' (Online or Mobile) or 'Physical' for high-level channel reporting."
            },
            {
              "id": "tppMbhGwLw",
              "formula": "If([Net Revenue] >= 500, \"High\", If([Net Revenue] >= 100, \"Medium\", \"Low\"))",
              "name": "Revenue Tier",
              "description": "Categorizes each order line by net revenue into 'High' (\u2265$500), 'Medium' (\u2265$100), or 'Low' tiers."
            }
