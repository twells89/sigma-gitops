              "format": {
                "kind": "number",
                "formatString": "$,.2f",
                "currencySymbol": "$"
              }
            },
            {
              "id": "NNO47EWMGA",
              "formula": "Sum([Gross Profit]) / Sum([Gross Revenue])",
              "name": "Gross Margin %",
              "description": "Gross profit as a pct of gross revenue",
